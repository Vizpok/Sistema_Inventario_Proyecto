# Copia este archivo como .env y llena los valores (nunca subas .env a GitHub).

# Conexión de la APLICACIÓN WEB: usuario app_nexo (miembro del rol "user": CRUD sin crear objetos)
DATABASE_URL=postgresql://app_nexo:CONTRASEÑA@ep-xxxx-pooler.REGION.aws.neon.tech/nexo_inventario?sslmode=require

# Conexión del PROPIETARIO (sólo para ejecutar los scripts .sql con `npm run sql`)
DATABASE_URL_OWNER=postgresql://nexo_inventario_owner:CONTRASEÑA@ep-xxxx-pooler.REGION.aws.neon.tech/nexo_inventario?sslmode=require

# Contraseñas que se usan al crear los usuarios de BD (script 02) y para las evidencias
PWD_DEV_ANA=
PWD_DEV_LUIS=
PWD_APP_NEXO=
PWD_USR_CARLOS=

# Secreto para firmar la cookie de sesión
SESSION_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
PORT=3000
