<%- include('../partials/inicio') %>
<% const p = producto; const edicion = !!p.id_producto; %>
<div>
  <a class="volver" href="<%= edicion ? '/catalogo/' + p.id_producto : '/catalogo' %>"><%- icono('flecha') %> <%= edicion ? 'Volver al producto' : 'Catálogo' %></a>
  <div class="page-head"><div><h1><%= titulo %></h1><p class="sub">Los datos se validan en la aplicación y también con restricciones CHECK / UNIQUE en PostgreSQL.</p></div></div>
</div>

<% if (typeof errores !== 'undefined' && errores.length) { %>
  <div class="alerta alerta-error" role="alert"><%- icono('alerta') %><ul><% errores.forEach(e => { %><li><%= e %></li><% }) %></ul></div>
<% } %>

<form method="post" action="<%= edicion ? '/catalogo/' + p.id_producto : '/catalogo' %>" class="card form">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="form-grid form-grid-3">
    <label class="campo"><span>SKU *</span><input type="text" name="sku" value="<%= p.sku || '' %>" required maxlength="20" placeholder="COM-LAP-004"></label>
    <label class="campo" style="grid-column: span 2"><span>Nombre *</span><input type="text" name="nombre" value="<%= p.nombre || '' %>" required maxlength="150"></label>
    <label class="campo"><span>Categoría *</span>
      <select name="id_categoria" required>
        <option value="">Selecciona…</option>
        <% categorias.forEach(c => { %><option value="<%= c.id_categoria %>" <%= Number(p.id_categoria) === c.id_categoria ? 'selected' : '' %>><%= c.nombre %></option><% }) %>
      </select>
    </label>
    <label class="campo"><span>Unidad</span>
      <select name="unidad">
        <% ['pieza', 'caja', 'paquete', 'bobina', 'juego', 'litro', 'metro'].forEach(u => { %><option <%= p.unidad === u ? 'selected' : '' %>><%= u %></option><% }) %>
      </select>
    </label>
    <div></div>
    <label class="campo"><span>Precio de compra *</span><input type="number" name="precio_compra" value="<%= p.precio_compra ?? '' %>" min="0" step="0.01" required></label>
    <label class="campo"><span>Precio de venta *</span><input type="number" name="precio_venta" value="<%= p.precio_venta ?? '' %>" min="0" step="0.01" required></label>
    <div></div>
    <label class="campo"><span>Stock mínimo</span><input type="number" name="stock_minimo" value="<%= p.stock_minimo ?? 0 %>" min="0" step="1"><small>Por debajo se marca como “Bajo”.</small></label>
    <label class="campo"><span>Stock máximo</span><input type="number" name="stock_maximo" value="<%= p.stock_maximo ?? 0 %>" min="0" step="1"><small>0 = sin máximo.</small></label>
    <div></div>
    <label class="campo col-completa"><span>Descripción</span><textarea name="descripcion"><%= p.descripcion || '' %></textarea></label>
  </div>

  <div class="seccion-form">
    <h2>Proveedores</h2>
    <p class="sub" style="margin-bottom: 12px">Relación N:M: un producto puede surtirse de varios proveedores; sólo uno es el principal (índice único parcial).</p>
    <div class="tabla-scroll">
      <table class="tabla tabla-prov">
        <thead><tr><th>Surte</th><th>Proveedor</th><th class="num">Costo</th><th class="num">Días entrega</th><th>Principal</th></tr></thead>
        <tbody>
          <% proveedores.forEach(pr => { %>
            <tr>
              <td><input type="checkbox" class="check" name="prov[p<%= pr.id_proveedor %>][sel]" value="1" <%= pr.seleccionado ? 'checked' : '' %> aria-label="Seleccionar <%= pr.razon_social %>"></td>
              <td><%= pr.razon_social %><div class="muted" style="font-size: 12px"><%= pr.ciudad %></div></td>
              <td class="num"><input type="number" name="prov[p<%= pr.id_proveedor %>][costo]" value="<%= pr.costo ?? '' %>" min="0" step="0.01" placeholder="= compra"></td>
              <td class="num"><input type="number" name="prov[p<%= pr.id_proveedor %>][dias]" value="<%= pr.dias_entrega ?? 3 %>" min="0" step="1"></td>
              <td><input type="radio" name="principal" value="<%= pr.id_proveedor %>" <%= pr.es_principal ? 'checked' : '' %> aria-label="Proveedor principal"></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="form-acciones">
    <a class="btn btn-fantasma" href="<%= edicion ? '/catalogo/' + p.id_producto : '/catalogo' %>">Cancelar</a>
    <button class="btn btn-primario"><%- icono('check') %> Guardar producto</button>
  </div>
</form>
<%- include('../partials/fin') %>
