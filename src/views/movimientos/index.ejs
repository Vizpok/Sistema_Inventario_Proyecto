<%- include('../partials/inicio') %>
<div class="page-head">
  <div><h1>Registro de movimientos</h1><p class="sub">Kardex de entradas y salidas de todos los almacenes.</p></div>
  <div class="acciones"><a class="btn btn-primario" href="/movimientos/nuevo"><%- icono('mas') %> Registrar movimiento</a></div>
</div>

<form class="filtros" method="get">
  <label class="campo campo-ancho"><span>Buscar</span><input type="search" name="q" value="<%= filtros.q %>" placeholder="Producto, SKU, folio o referencia"></label>
  <label class="campo"><span>Naturaleza</span>
    <select name="naturaleza"><option value="">Todas</option><option <%= filtros.naturaleza === 'ENTRADA' ? 'selected' : '' %> value="ENTRADA">Entradas</option><option <%= filtros.naturaleza === 'SALIDA' ? 'selected' : '' %> value="SALIDA">Salidas</option></select>
  </label>
  <label class="campo"><span>Tipo</span>
    <select name="tipo"><option value="">Todos</option><% tipos.forEach(t => { %><option value="<%= t.id_tipo %>" <%= String(t.id_tipo) === filtros.tipo ? 'selected' : '' %>><%= t.nombre %></option><% }) %></select>
  </label>
  <label class="campo"><span>Almacén</span>
    <select name="almacen"><option value="">Todos</option><% almacenes.forEach(a => { %><option value="<%= a.id_almacen %>" <%= String(a.id_almacen) === filtros.almacen ? 'selected' : '' %>><%= a.nombre %></option><% }) %></select>
  </label>
  <label class="campo"><span>Desde</span><input type="date" name="desde" value="<%= filtros.desde %>"></label>
  <label class="campo"><span>Hasta</span><input type="date" name="hasta" value="<%= filtros.hasta %>"></label>
  <div class="botones"><button class="btn btn-primario"><%- icono('buscar') %> Filtrar</button><a class="btn btn-fantasma" href="/movimientos">Limpiar</a></div>
</form>

<section class="kpis">
  <article class="kpi"><div class="kpi-ico ico-indigo"><%- icono('movimientos') %></div><div><p class="kpi-etiqueta">Movimientos</p><p class="kpi-valor"><%= numero(totales.registros) %></p><p class="kpi-nota">con los filtros actuales</p></div></article>
  <article class="kpi"><div class="kpi-ico ico-verde"><%- icono('entrada') %></div><div><p class="kpi-etiqueta">Unidades de entrada</p><p class="kpi-valor"><%= numero(totales.unidades_entrada) %></p><p class="kpi-nota"><%= moneda(totales.importe_entrada) %></p></div></article>
  <article class="kpi"><div class="kpi-ico ico-rojo"><%- icono('salida') %></div><div><p class="kpi-etiqueta">Unidades de salida</p><p class="kpi-valor"><%= numero(totales.unidades_salida) %></p><p class="kpi-nota"><%= moneda(totales.importe_salida) %> a costo</p></div></article>
  <article class="kpi"><div class="kpi-ico ico-azul"><%- icono('dinero') %></div><div><p class="kpi-etiqueta">Balance de unidades</p><p class="kpi-valor"><%= Number(totales.unidades_entrada) - Number(totales.unidades_salida) >= 0 ? '+' : '' %><%= numero(Number(totales.unidades_entrada) - Number(totales.unidades_salida)) %></p><p class="kpi-nota">entradas − salidas</p></div></article>
</section>

<article class="card card-sin-padding">
  <div class="tabla-scroll">
    <table class="tabla">
      <thead><tr><th>Folio</th><th>Fecha</th><th>Tipo</th><th>Producto</th><th>Almacén</th><th class="num">Cantidad</th><th class="num">Existencia</th><th>Referencia</th><th>Usuario</th></tr></thead>
      <tbody>
        <% if (!filas.length) { %><tr><td colspan="9" class="vacio">No hay movimientos con esos filtros.</td></tr><% } %>
        <% filas.forEach(m => { %>
          <tr>
            <td><a class="mono" href="/movimientos/<%= m.id_movimiento %>"><%= m.folio %></a></td>
            <td class="muted" style="white-space: nowrap"><%= fechaHora(m.fecha) %></td>
            <td><span class="tipo tipo-<%= m.naturaleza.toLowerCase() %>"><%- icono(m.naturaleza === 'ENTRADA' ? 'entrada' : 'salida') %><%= m.tipo %></span><% if (m.proveedor) { %><div class="muted" style="font-size: 12px"><%= m.proveedor %></div><% } %></td>
            <td><div class="celda-producto"><a href="/catalogo/<%= m.id_producto %>"><%= m.producto %></a><span class="muted mono"><%= m.sku %></span></div></td>
            <td><%= m.almacen %></td>
            <td class="num <%= m.naturaleza === 'ENTRADA' ? 'txt-entrada' : 'txt-salida' %>"><%= m.naturaleza === 'ENTRADA' ? '+' : '−' %><%= numero(m.cantidad) %></td>
            <td class="num"><%= numero(m.existencia_resultante) %></td>
            <td class="mono muted"><%= m.referencia || '—' %></td>
            <td><%= m.usuario %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <%- include('../partials/paginacion', { base: '/movimientos', filtrosPag: filtros, total: totales.registros }) %>
</article>
<%- include('../partials/fin') %>
